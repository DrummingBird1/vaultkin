{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
    // Deliberately NO "baseUrl". The root tsconfig.json sets baseUrl: "."
    // for its @core/@services/etc. path aliases — but this project's config
    // file is required (by electron-builder's own findAndReadConfig) to be
    // literally named electron-builder.ts at the project root. Combined with
    // baseUrl: ".", TypeScript's non-relative module resolution tries
    // baseUrl-relative candidates before node_modules, so the bare import
    // "electron-builder" resolves to THIS FILE ITSELF instead of the npm
    // package — a self-import collision, confirmed via `tsc --traceResolution`.
    // Giving this one file its own tsconfig without baseUrl sidesteps it
    // entirely, the same way config/tsconfig.electron.json already exists
    // as a separate context for src/electron/.
  },
  "include": ["../electron-builder.ts"]
}
