{
  "name": "securevault",
  "version": "2.0.0",
  "description": "Zero-knowledge password manager & 2FA authenticator",
  "main": "dist/electron/main.js",
  "homepage": "https://github.com/securevault/securevault",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build --config config/vite.config.ts",
    "build:analyze": "cross-env BUILD_ANALYZE=true pnpm run build",
    "build:electron": "tsc -p config/tsconfig.electron.json",
    "build:extension": "node scripts/build-extension.mjs",
    "build:extension:release": "node scripts/build-extension.mjs --release",
    "build:cli": "node scripts/build-cli.mjs",
    "validate:extension": "node scripts/validate-extension-manifest.mjs",
    "dev": "vite --config config/vite.config.ts",
    "electron:build": "pnpm run build && pnpm run build:electron",
    "electron:dev": "concurrently -k \"pnpm:dev\" \"pnpm:electron:wait\"",
    "electron:wait": "wait-on tcp:5173 && pnpm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron:dist": "pnpm run electron:build && electron-builder",
    "electron:dist:mac": "pnpm run electron:build && electron-builder --mac --universal",
    "electron:dist:win": "pnpm run electron:build && electron-builder --win",
    "electron:dist:linux": "pnpm run electron:build && electron-builder --linux",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "preview": "vite preview --config config/vite.config.ts",
    "test": "vitest run --config config/vitest.config.ts",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "test:e2e:headed": "playwright test --config config/playwright.config.ts --headed",
    "test:e2e:ui": "playwright test --config config/playwright.config.ts --ui",
    "test:watch": "vitest --config config/vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc -p config/tsconfig.extension.json",
    "typecheck:electron-builder": "tsc -p config/tsconfig.electron-builder.json --noEmit",
    "sbom": "pnpm dlx @cyclonedx/cdxgen -o sbom.json --type npm .",
    "lockfile:lint": "node scripts/lint-lockfile.mjs",
    "docs:api": "typedoc",
    "test:mutation": "stryker run",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "lighthouse": "lhci autorun --config=config/lighthouserc.cjs",
    "test:e2e:electron": "pnpm run build:electron && playwright test --config config/playwright.electron.config.ts"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.5.0",
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.9",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/qrcode-generator": "^0.0.16",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.9.0",
    "globals": "^17.9.0",
    "hash-wasm": "4.12.0",
    "husky": "^9.1.7",
    "i18next": "^26.3.6",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "lucide-react": "^1.77.0",
    "prettier": "^3.9.6",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.5",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.5.1",
    "workbox-window": "7.4.1",
    "zustand": "^5.0.14"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "bin": {
    "sv": "dist/cli/sv.cjs"
  }
}
