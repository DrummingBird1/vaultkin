{
  "name": "SecureVault",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  // corepack ships with Node 20+ and is how `packageManager: "pnpm@..."`
  // in package.json gets honored without a separate global pnpm install.
  // Playwright's --with-deps pulls in the apt packages Chromium/Firefox/
  // WebKit need to run headless inside this container; it measurably adds
  // to the first-build time, but without it `pnpm run test:e2e` just hangs
  // or fails on missing system libraries instead of running.
  "onCreateCommand": "corepack enable && corepack prepare pnpm@11 --activate",
  "postCreateCommand": "pnpm install && pnpm exec playwright install --with-deps chromium firefox webkit",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Vite dev server", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright",
        "editorconfig.editorconfig"
      ]
    }
  },
  "remoteUser": "node"
}
